{
  "name": "dio-explorer",
  "version": "1.0.0",
  "description": "CLI com slash commands para explorar trilhas da DIO",
  "main": "src/index.js",
  "bin": {
    "dio": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "trilha": "node src/index.js /trilha",
    "desafio": "node src/index.js /desafio",
    "certificado": "node src/index.js /certificado",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage --coverageReporters=text --coverageReporters=json-summary",
    "test:verbose": "node --experimental-vm-modules node_modules/.bin/jest --coverage --verbose --coverageReporters=text"
  },
  "type": "module",
  "keywords": [
    "dio",
    "cli",
    "trilhas",
    "desafio",
    "certificado"
  ],
  "author": "markosluciano",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [],
    "transform": {},
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 70,
        "branches": 60,
        "statements": 70
      }
    }
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
